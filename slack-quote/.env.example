# Copy to .env and fill in. NEVER commit the real .env.

# Warp freight API — this round you run the local mock (node mock/server.js).
# No real key needed; the mock ignores it.
WARP_API_KEY=mock
WARP_API_BASE_URL=http://localhost:3001

# Slack app credentials — from your own free Slack workspace's app config
# (https://api.slack.com/apps). The signing secret is the only Slack credential this
# app needs: every reply goes back through the response_url Slack hands us with the
# request, so there is no bot token to leak.
SLACK_SIGNING_SECRET=

# Optional tuning.
# A rate shop is a billable carrier call, so repeat lanes are served from cache.
QUOTE_CACHE_TTL_SECONDS=900
# Retry budget for the slow, flaky quote endpoints.
WARP_MAX_ATTEMPTS=3
WARP_TOTAL_DEADLINE_SECONDS=45
# Where the usage log lives.
QUOTE_LOG_DB=quotes.db
